# Copy this file to .env (git ignores .env) and fill in the values. The make targets load .env.
# Never commit .env or paste these values into chats, issues or screenshots.

# Bhashini (bhashini.gov.in): from your organisation's account, "My Profile".
BHASHINI_USER_ID=
BHASHINI_API_KEY=
# The pipeline your account is allowed to use (from your Bhashini account or the pipeline search call).
BHASHINI_PIPELINE_ID=

# Optional. A long random string that keeps PIN hashes safe if the database leaks. Without it the server
# creates data/secret_pepper on first use. Changing it later invalidates every existing PIN.
# HUNAR_PIN_PEPPER=

# Optional, development only: "test" shows SMS codes on screen instead of sending them.
# HUNAR_OTP_PROVIDER=test
