      "type": "string",
      "title": "Task Id"
     },
     "ticks": {
      "additionalProperties": {
       "type": "boolean"
      },
      "type": "object",
      "title": "Ticks"
     },
     "actor": {
      "type": "string",
      "title": "Actor"
     }
    },
    "type": "object",
    "required": [
     "task_id",
     "ticks",
     "actor"
    ],
    "title": "ChecklistIn"
   },
   "ConfirmPackIn": {
    "properties": {
     "nqr_id": {
      "type": "integer",
      "title": "Nqr Id"
     },
     "actor": {
      "type": "string",
      "title": "Actor"
     },
