      "title": "Photo Id"
     },
     "consent_confirmed": {
      "type": "boolean",
      "title": "Consent Confirmed",
      "default": false
     },
     "actor": {
      "type": "string",
      "title": "Actor",
      "default": "facilitator"
     },
     "file": {
      "type": "string",
      "contentMediaType": "application/octet-stream",
      "title": "File"
     }
    },
    "type": "object",
    "required": [
     "task_id",
     "photo_id",
     "file"
    ],
    "title": "Body_add_evidence_api_assessments__aid__evidence_post"
   },
